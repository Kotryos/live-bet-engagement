{
  "name": "offers-sink",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "3",
    "topics": "offers",

    "connection.url": "jdbc:postgresql://postgres:5432/engagement",
    "connection.user": "postgres",
    "connection.password": "postgres",

    "insert.mode": "upsert",
    "pk.mode": "record_key",
    "pk.fields": "player_id",
    "table.name.format": "offers",
    "auto.create": "false",
    "auto.evolve": "false",

    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "dlq-offers",
    "errors.deadletterqueue.topic.replication.factor": "1",
    "errors.deadletterqueue.context.headers.enable": "true"
  }
}
